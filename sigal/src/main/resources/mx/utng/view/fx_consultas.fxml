<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    fx_consultas.fxml
    Pantalla "Consultas" de SIGAL: filtra las asignaciones ya
    registradas y las muestra en una tabla.
    Controller: mx.utng.controller.ConsultaController
    Estilos: styles_consultas.css

    Se carga dentro del panel central del menú (contentPane), tal
    como el resto de los módulos (Asignaciones, Espacios, etc.), así
    que no necesita fondo de pantalla completa: el fondo lo pone el
    "cascarón" del menú (fx_menu.fxml).
-->

<ScrollPane fitToWidth="true" styleClass="consultas-scroll" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.ConsultaController">

    <VBox spacing="20.0" styleClass="consultas-content">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="24.0" />
        </padding>

        <!-- ===== Encabezado ===== -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" />

        <!-- ===== Tarjeta de filtros ===== -->
        <VBox spacing="16.0" styleClass="consultas-card">

            <GridPane hgap="16.0" vgap="4.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>
                <Label styleClass="filter-label" text="Solicitante" GridPane.rowIndex="3" />
                <Label styleClass="filter-label" text="Tipo de espacio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label styleClass="filter-label" text="Espacio" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                <Label styleClass="filter-label" text="Estado de la asignación" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbTipoEspacio" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <ComboBox fx:id="cmbEspacio" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                <!-- Fila 3: etiquetas -->
                <Label styleClass="filter-label" text="Carrera" GridPane.columnIndex="4" GridPane.rowIndex="3" />
                <Label styleClass="filter-label" text="Materia" GridPane.rowIndex="10" />
                <Label styleClass="filter-label" text="Grupo" GridPane.columnIndex="1" GridPane.rowIndex="10" />

                <!-- Fila 4: campos -->
                <ComboBox fx:id="cmbCarrera" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="4" GridPane.rowIndex="6" />
            <ComboBox fx:id="cmbSolicitante" maxWidth="Infinity" promptText="Todos" GridPane.rowIndex="6" />
            <ComboBox fx:id="cmbGrupo" maxWidth="Infinity" promptText="Todos" GridPane.columnIndex="1" GridPane.rowIndex="12" />
            <ComboBox fx:id="cmbMateria" maxWidth="Infinity" promptText="Todos" GridPane.rowIndex="12" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
   
               <!-- Rango de fechas + botones -->
    
            </GridPane>
            <Label styleClass="filter-label" text="Rango de fechas" GridPane.columnIndex="2" GridPane.rowIndex="7" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label styleClass="filter-inline-label" text="Desde" />
                <DatePicker fx:id="dtDesde" prefWidth="150.0" />
                <Label styleClass="filter-inline-label" text="Hasta" />
                <DatePicker fx:id="dtHasta" prefWidth="150.0" />

                         <Region HBox.hgrow="ALWAYS" />

                         <Button fx:id="btnLimpiar" onAction="#onLimpiarFiltros" styleClass="btn-secundario" text="Limpiar filtros" />
                <Button fx:id="btnBuscar" onAction="#onBuscar" styleClass="btn-primario" text="🔍  Buscar" />
            </HBox>

        </VBox>

        <!-- ===== Tarjeta de resultados ===== -->
        <VBox spacing="12.0" styleClass="consultas-card">

            <HBox alignment="CENTER_LEFT" spacing="4.0">
                <Label styleClass="resultados-titulo" text="Resultados de la búsqueda" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="resultados-texto" text="Se encontraron" />
                <Label fx:id="lblCantidadResultados" styleClass="resultados-numero" text="0" />
                <Label styleClass="resultados-texto" text="asignaciones" />
                <Button fx:id="btnExportar" onAction="#onExportar" styleClass="btn-secundario" text="⬇  Exportar" />
            </HBox>

            <TableView fx:id="tblResultados" prefHeight="320.0" styleClass="consultas-tabla">
                <columns>
                    <TableColumn fx:id="colHorario" prefWidth="100.0" text="Horario" />
                    <TableColumn fx:id="colEspacio" prefWidth="140.0" text="Espacio" />
                    <TableColumn fx:id="colSolicitante" prefWidth="170.0" text="Profesor / Solicitante" />
                    <TableColumn fx:id="colGrupo" prefWidth="90.0" text="Grupo" />
                    <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                    <TableColumn fx:id="colMotivo" prefWidth="140.0" text="Motivo" />
                    <TableColumn fx:id="colCarrera" prefWidth="130.0" text="Carrera" />
                    <TableColumn fx:id="colMateria" prefWidth="130.0" text="Materia" />
                </columns>
            </TableView>

        </VBox>

    </VBox>
   <stylesheets>
      <URL value="@con" />
      <URL value="@styles_consultas.css" />
   </stylesheets>

</ScrollPane>
