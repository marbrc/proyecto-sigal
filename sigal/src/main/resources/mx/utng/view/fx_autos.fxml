<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    fx_autos.fxml
    Pantalla de Gestión de Autos, con la misma temática visual
    que fx_login.fxml y fx_menu.fxml (imagen de fondo + colores oscuros/rojos).
    Controller: mx.utng.controller.AutosController
-->
<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.utng.controller.AutosController">

    <!-- 1) Imagen de fondo, la misma del login y el menú -->
    <ImageView fitHeight="700.0" fitWidth="1100.0" pickOnBounds="true" preserveRatio="false"
               AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <image>
            <Image url="@img/fondo.jpg" />
        </image>
    </ImageView>

    <!-- 2) Capa oscura encima de la imagen -->
    <AnchorPane style="-fx-background-color: rgba(0,0,0,0.55);"
                 AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                 AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

    <!-- 3) Contenido de la pantalla, encima de todo -->
    <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- ==================== TÍTULO ==================== -->
        <top>
            <Label text="Gestión de Autos" textFill="WHITE" BorderPane.alignment="CENTER">
                <font>
                    <Font name="System Bold" size="24" />
                </font>
                <padding>
                    <Insets bottom="15" top="15" />
                </padding>
            </Label>
        </top>

        <!-- ==================== FORMULARIO ==================== -->
        <center>

            <VBox spacing="15" style="-fx-background-color: rgba(20,15,15,0.55);">

                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <GridPane hgap="10" vgap="10">

                    <Label text="Marca" textFill="WHITE" />
                    <TextField fx:id="txtMarca" GridPane.columnIndex="1" />

                    <Label text="Modelo" textFill="WHITE" GridPane.rowIndex="1" />
                    <TextField fx:id="txtModelo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Kilometraje" textFill="WHITE" GridPane.columnIndex="2" />
                    <TextField fx:id="txtKilometraje" GridPane.columnIndex="3" />

                    <Label text="Precio" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="txtPrecio" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>

                </GridPane>

                <!-- BOTONES -->
                <HBox spacing="10">
                    <Button fx:id="btnNuevo" onAction="#nuevo" text="Nuevo"
                            style="-fx-background-color: #3a3a3a; -fx-text-fill: white;" />
                    <Button fx:id="btnGuardar" onAction="#guardarAuto" text="Guardar"
                            style="-fx-background-color: #b0342e; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Button fx:id="btnActualizar" onAction="#actualizar" text="Actualizar"
                            style="-fx-background-color: #b0342e; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Button fx:id="btnEliminar" onAction="#eliminar" text="Eliminar"
                            style="-fx-background-color: #3a3a3a; -fx-text-fill: white;" />
                </HBox>

                <!-- BUSCADOR -->
                <HBox spacing="10">
                    <Label text="Buscar por ID" textFill="WHITE" />
                    <TextField fx:id="txtBuscar" />
                    <Button fx:id="btnBuscar" onAction="#buscar" text="Buscar"
                            style="-fx-background-color: #b0342e; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tblAutos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="90" text="ID" />
                        <TableColumn fx:id="colMarca" prefWidth="160" text="Marca" />
                        <TableColumn fx:id="colModelo" prefWidth="160" text="Modelo" />
                        <TableColumn fx:id="colKilometraje" prefWidth="130" text="Kilometraje" />
                        <TableColumn fx:id="colPrecio" prefWidth="120" text="Precio" />
                    </columns>
                </TableView>

            </VBox>

        </center>

    </BorderPane>

</AnchorPane>
