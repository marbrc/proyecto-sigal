<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="login-root" stylesheets="@styles_login.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.LoginController">

    <!-- TARJETA DE LOGIN -->
    <StackPane styleClass="login-card">

        <HBox fillHeight="true">

            <!-- ============ PANEL IZQUIERDO: FOTO + PRESENTACIÓN ============ -->
            <StackPane styleClass="login-left" HBox.hgrow="ALWAYS">

                   <!-- Degradado oscuro sobre la foto para que el texto se lea -->
                <Region styleClass="login-left-overlay" />

                <VBox alignment="CENTER" maxWidth="620.0" spacing="14.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>

                    <Region maxHeight="10.0" VBox.vgrow="ALWAYS" />

                    <ImageView fitHeight="280.0" fitWidth="280.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image backgroundLoading="true" url="@assets/logo.png" />
                        </image>
                        <effect>
                            <DropShadow color="#4fc3ff" radius="40" spread="0.15" />
                        </effect>
                    </ImageView>

                    <VBox alignment="CENTER" spacing="4.0">
                        <Label styleClass="login-tagline" text="SISTEMA DE GESTIÓN Y" />
                        <Label styleClass="login-tagline" text="ASIGNACIÓN DE LABORATORIOS" />
                    </VBox>

                    <Region maxWidth="90.0" minHeight="2.0" prefHeight="2.0" styleClass="login-divider" />

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="14.0" styleClass="login-info-chip">
                        <StackPane styleClass="login-info-icon-box">
                            <Region styleClass="icon-building icon-md icon-white" />
                        </StackPane>
                        <Label maxWidth="380.0" styleClass="login-info-text" text="Administra espacios, horarios y reservaciones del Edificio F en un solo lugar." wrapText="true" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" maxWidth="480.0" spacing="12.0">
                        <Region minHeight="30.0" prefWidth="1.0" styleClass="login-utng-sep" />
                        <Label styleClass="login-utng-text" text="UNIVERSIDAD TECNOLÓGICA DEL NORTE DE GUANAJUATO" wrapText="true" />
                    </HBox>
                    <HBox maxWidth="480.0">
                        <Region prefWidth="72.0" />
                    </HBox>

                </VBox>
            </StackPane>

            <!-- ============ PANEL DERECHO: FORMULARIO ============ -->
            <VBox alignment="CENTER" spacing="0.0" styleClass="login-right" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="40.0" left="70.0" right="70.0" top="50.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="18.0">
                    <StackPane styleClass="login-avatar-box">
                        <Region styleClass="icon-user icon-lg icon-accent" />
                  <Label prefHeight="24.0" prefWidth="18.0" styleClass="input-icon" text="👤" textFill="WHITE">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label styleClass="login-title" text="Bienvenido(a)" />
                        <Label styleClass="login-subtitle" text="Ingrese los datos para continuar" />
                    </VBox>
                </HBox>

                <Region minHeight="34.0" prefHeight="34.0" />

                <!-- Usuario -->
                <VBox spacing="10.0">
                    <Label styleClass="field-label" text="Usuario" />
                    <HBox fx:id="boxUsuario" alignment="CENTER_LEFT" spacing="12.0" styleClass="input-box">
                  <Label styleClass="input-icon" text="👤" textFill="WHITE" />
                        <Region styleClass="icon-user icon-sm icon-muted" />
                        <TextField fx:id="txtUsuario" promptText="usuario@utng.edu.mx" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Region minHeight="22.0" prefHeight="22.0" />

                <!-- Contraseña -->
                <VBox spacing="10.0">
                    <Label styleClass="field-label" text="Contraseña" />
                    <HBox fx:id="boxContrasena" alignment="CENTER" spacing="12.0" styleClass="input-box">
                  <Label prefHeight="19.0" prefWidth="18.0" styleClass="input-icon" text="🔒" textFill="WHITE" />
                        <Region styleClass="icon-lock icon-sm icon-muted" />
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="pwdContrasena" promptText="Ingrese su contraseña" styleClass="input-field" />
                            <TextField fx:id="txtContrasenaVisible" managed="false" promptText="Ingresa tu contraseña" styleClass="input-field" visible="false" />
                        </StackPane>
                        <Button fx:id="btnTogglePassword" onAction="#onTogglePassword" styleClass="input-eye-btn">
                            <graphic>
                                <StackPane>
                                    <Label styleClass="input-icon" text="👁" textFill="WHITE" />
                                </StackPane>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <Region minHeight="22.0" prefHeight="22.0" />

                <HBox alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkRecordarme" selected="true" styleClass="login-checkbox" text="Recordarme" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink styleClass="login-forgot-link" text="¿Olvidaste tu contraseña?" />
                </HBox>

                <Region minHeight="30.0" prefHeight="30.0" />

                <Button fx:id="btnIniciarSesion" maxWidth="Infinity" onAction="#onIniciarSesion" prefHeight="58.0" styleClass="login-submit-btn" text="[→]   Iniciar sesión" />

                <Region minHeight="28.0" prefHeight="28.0" />

                <HBox alignment="CENTER" spacing="10.0">
                    <Line endY="0" startY="0" styleClass="login-hr" HBox.hgrow="ALWAYS" />
                    <Region styleClass="icon-lock icon-tiny icon-muted" />
                    <Line endY="0" startY="0" styleClass="login-hr" HBox.hgrow="ALWAYS" />
                </HBox>

                <Region minHeight="10.0" prefHeight="10.0" />

                <Label styleClass="login-exclusive-text" text="Acceso exclusivo para personal autorizado" />

                <Region VBox.vgrow="ALWAYS" />

                <VBox alignment="CENTER" spacing="4.0">
                    <Label styleClass="login-footer-text" text="© 2026 SIGAL " />
                    <Label styleClass="login-version-text" text="Versión 1.0" />
                </VBox>

            </VBox>

        </HBox>
    </StackPane>
   <Label styleClass="input-icon" text="🔒" />
</StackPane>
