<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="page-root" stylesheets="@styles_espacios.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.EspaciosController">

    <VBox spacing="16.0">
        <padding>
            <Insets bottom="18.0" left="34.0" right="34.0" top="14.0" />
        </padding>

        <!-- ============ CONTENIDO: FORMULARIO + TABLA ============ -->
        <HBox spacing="18.0" VBox.vgrow="ALWAYS">

            <!-- ==== PANEL IZQUIERDO: DATOS DEL ESPACIO ==== -->
            <VBox prefWidth="400.0" spacing="14.0" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-title" text="Datos del espacio" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNuevoEspacio" onAction="#onNuevoEspacio" styleClass="btn-nuevo" text="+  Nuevo" />
                </HBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Clave del espacio *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="🏷" />
                        <TextField fx:id="txtClave" promptText="LAB TI-III" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Nombre del espacio *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="🏢" />
                        <TextField fx:id="txtNombre" promptText="Ej. Laboratorio de Seguridad" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Tipo de espacio *" />
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione el tipo de espacio" styleClass="input-combo" />
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Capacidad máxima *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="👥" />
                        <TextField fx:id="txtCapacidad" promptText="Ej. 30" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Estado *" />
                    <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione el estado" styleClass="input-combo" />
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <Label styleClass="field-label" text="Descripción / Observaciones (opcional)" />
                    <TextArea fx:id="txtDescripcion" prefRowCount="3" promptText="Información adicional del espacio..." styleClass="input-textarea" wrapText="true" />
                </VBox>

                <HBox spacing="8.0">
                    <Button fx:id="btnGuardar" maxWidth="Infinity" onAction="#onGuardar" styleClass="primary-btn" text="💾  Guardar" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="secondary-btn" text="↻  Limpiar" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="cancel-btn" text="✕  Cancelar" />
                </HBox>
            </VBox>

            <!-- ==== PANEL DERECHO: ESPACIOS REGISTRADOS ==== -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                <Label styleClass="card-title" text="Espacios registrados" />

                <HBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="input-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="input-icon" text="🔍" />
                        <TextField fx:id="txtBuscar" promptText="Buscar por clave o nombre..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="cmbFiltroTipo" prefWidth="160.0" styleClass="input-combo" />
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="160.0" styleClass="input-combo" />
                    <Button fx:id="btnRefrescar" onAction="#onRefrescar" styleClass="icon-btn" text="↻" />
                </HBox>

                <TableView fx:id="tblEspacios" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colClave" prefWidth="90.0" text="Clave" />
                        <TableColumn fx:id="colNombre" prefWidth="190.0" text="Nombre del espacio" />
                        <TableColumn fx:id="colTipo" prefWidth="170.0" text="Tipo" />
                        <TableColumn fx:id="colCapacidad" prefWidth="90.0" text="Capacidad" />
                        <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="100.0" sortable="false" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblResultados" styleClass="results-label" text="Mostrando 0 de 0 espacios" />
            </VBox>

        </HBox>
    </VBox>
</StackPane>
