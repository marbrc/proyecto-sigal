<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootRecuperar" styleClass="login-root" stylesheets="@styles_login.css,@styles_recuperar.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.RecuperarContrasenaController">



    <StackPane styleClass="login-card recuperar-card">
        <VBox alignment="CENTER" maxWidth="460.0" prefWidth="460.0" maxHeight="600.0" spacing="0.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-color: #2563eb; -fx-border-width: 2; -fx-border-radius: 20;">
            <padding>
                <Insets bottom="40.0" left="48.0" right="48.0" top="46.0" />
            </padding>

            <StackPane styleClass="login-avatar-box">
                <Region styleClass="icon-lock icon-lg icon-accent" />
            </StackPane>

            <Region minHeight="16.0" prefHeight="16.0" />

            <Label fx:id="lblTituloPaso" styleClass="login-title" text="Recuperar contraseña" textFill="#181717" />

            <Region minHeight="4.0" prefHeight="4.0" />

            <Label fx:id="lblSubtituloPaso" styleClass="login-subtitle" text="Ingresa tus datos para continuar" textAlignment="CENTER" wrapText="true" />

            <Region minHeight="30.0" prefHeight="30.0" />

            <!-- ============ PASO 1: SOLICITAR ============ -->
            <VBox fx:id="paneSolicitar" managed="true" spacing="20.0" visible="true">

                <VBox spacing="10.0">
                    <Label styleClass="field-label" text="Usuario" textFill="WHITE" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="input-box">
                        <Region styleClass="icon-user icon-sm icon-muted" />
                        <TextField fx:id="txtUsuarioRec" promptText="usuario_sigal" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="10.0">
                    <Label styleClass="field-label" text="Correo electrónico" textFill="WHITE" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="input-box">
                        <Region styleClass="icon-lock icon-sm icon-muted" />
                        <TextField fx:id="txtCorreoRec" promptText="tucorreo@utng.edu.mx" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Region minHeight="10.0" prefHeight="10.0" />

                <HBox spacing="14.0">
                    <Button fx:id="btnCancelar1" maxWidth="Infinity" onAction="#onRegresarLogin" styleClass="recuperar-btn-secundario" text="Cancelar" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #2563eb;" />
                    <Button fx:id="btnEnviarCodigo" maxWidth="Infinity" onAction="#onEnviarCodigo" styleClass="login-submit-btn" text="Enviar código" HBox.hgrow="ALWAYS" />
                </HBox>

            </VBox>
<!-- ============ PASO 2: CÓDIGO ============ -->
            <VBox fx:id="paneCodigo" managed="false" spacing="20.0" visible="false">

                <Label fx:id="lblCorreoEnviado" styleClass="login-info-text" text="Enviamos un código a tu correo" wrapText="true" style="-fx-text-fill: #2563eb;" />

                    <VBox spacing="10.0">
                        <Label styleClass="field-label" text="Código de verificación" style="-fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="input-box" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;">
                            <Region styleClass="icon-lock icon-sm icon-muted" />
                            <TextField fx:id="txtCodigo" promptText="000000" styleClass="input-field codigo-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label fx:id="lblTimer" styleClass="login-exclusive-text" text="El código vence en 10:00" style="-fx-text-fill: #0f172a;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink fx:id="lnkReenviar" onAction="#onReenviarCodigo" styleClass="login-forgot-link" text="Reenviar código" style="-fx-text-fill: #2563eb; -fx-underline: false;" />
                    </HBox>

    <Region minHeight="6.0" prefHeight="6.0" />

    <HBox spacing="14.0">
        <Button fx:id="btnRegresarPaso1" maxWidth="Infinity" onAction="#onRegresarPaso1" styleClass="recuperar-btn-secundario" text="Regresar" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #2563eb;" />
        <Button fx:id="btnVerificarCodigo" maxWidth="Infinity" onAction="#onVerificarCodigo" styleClass="login-submit-btn" text="Verificar" HBox.hgrow="ALWAYS" style="-fx-background-color: #2563eb; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

</VBox>

            <!-- ============ PASO 3: NUEVA CONTRASEÑA ============ -->
            <VBox fx:id="paneNueva" managed="false" spacing="20.0" visible="false">

                <VBox spacing="10.0">
                    <Label styleClass="field-label" text="Nueva contraseña" style="-fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                    <HBox alignment="CENTER" spacing="12.0" styleClass="input-box" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;">
                        <Region styleClass="icon-lock icon-sm icon-muted" />
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="pwdNueva" promptText="Ingresa tu nueva contraseña" styleClass="input-field" />
                            <TextField fx:id="txtNuevaVisible" managed="false" promptText="Ingresa tu nueva contraseña" styleClass="input-field" visible="false" />
                        </StackPane>
                        <Button fx:id="btnToggleNueva" onAction="#onToggleNueva" styleClass="input-eye-btn">
                            <graphic>
                                <Label styleClass="input-icon" text="👁" textFill="#2563eb" />
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <VBox spacing="10.0">
                <Label styleClass="field-label" text="Confirmar contraseña" style="-fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                <HBox alignment="CENTER" spacing="12.0" styleClass="input-box" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10;">
                    <Region styleClass="icon-lock icon-sm icon-muted" />
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="pwdConfirmar" promptText="Confirma tu nueva contraseña" styleClass="input-field" />
                        <TextField fx:id="txtConfirmarVisible" managed="false" promptText="Confirma tu nueva contraseña" styleClass="input-field" visible="false" />
                    </StackPane>
                    <Button fx:id="btnToggleConfirmar" onAction="#onToggleConfirmar" styleClass="input-eye-btn">
                        <graphic>
                            <Label styleClass="input-icon" text="👁" textFill="#2563eb" />
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

    <Region minHeight="10.0" prefHeight="10.0" />

    <HBox spacing="14.0">
        <Button fx:id="btnCancelar3" maxWidth="Infinity" onAction="#onRegresarLogin" styleClass="recuperar-btn-secundario" text="Cancelar" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #2563eb; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #2563eb;" />
        <Button fx:id="btnGuardarContrasena" maxWidth="Infinity" onAction="#onGuardarContrasena" styleClass="login-submit-btn" text="Guardar contraseña" HBox.hgrow="ALWAYS" style="-fx-background-color: #2563eb; -fx-background-radius: 12; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>

</VBox>

        </VBox>
    </StackPane>
</StackPane>
