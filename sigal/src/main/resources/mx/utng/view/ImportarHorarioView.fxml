<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.DatePicker?>

<!--
    Pantalla emergente: Importar horario desde Excel
    Se muestra como contenido de un Stage modal (ver ImportarHorarioController.abrir(...))
-->
<VBox fx:id="rootImportar"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
        fx:controller="mx.utng.controller.ImportarHorarioController"      styleClass="modal-card"
      spacing="4">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Importar horario desde Excel" styleClass="modal-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCerrar" text="✕" styleClass="btn-close" onAction="#onCerrar"/>
    </HBox>

    <Label text="Los espacios importados quedarán fijos durante todo el cuatrimestre."
           styleClass="modal-subtitle" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Inicio del cuatrimestre"/>
            <DatePicker fx:id="dpInicioCuatrimestre"/>
        </VBox>

    <VBox spacing="4">
        <Label text="Fin del cuatrimestre"/>
        <DatePicker fx:id="dpFinCuatrimestre"/>
    </VBox>
</HBox>

    <Region minHeight="12"/>

    <!-- Paso 1: descargar plantilla -->
    <HBox spacing="10" alignment="TOP_LEFT">
        <Label text="1" styleClass="step-badge"/>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Descarga la plantilla y llénala con tus horarios" wrapText="true"/>
            <Button fx:id="btnDescargarPlantilla" text="⬇ Descargar plantilla (.xlsx)"
                    styleClass="btn-secondary" onAction="#onDescargarPlantilla"/>
        </VBox>
    </HBox>

    <StackPane styleClass="info-box">
        <Label text="Columnas: Tipo de espacio · Nombre del espacio · Día · Hora de inicio · Hora de término · Grupo"
               wrapText="true" styleClass="info-box-text"/>
    </StackPane>

    <Region minHeight="12"/>

    <!-- Paso 2: subir archivo -->
    <HBox spacing="10" alignment="TOP_LEFT">
        <Label text="2" styleClass="step-badge"/>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Sube el archivo ya lleno" wrapText="true"/>

            <StackPane fx:id="dropArea" styleClass="drop-area">
                <VBox alignment="CENTER" spacing="6">
                    <Label text="⬆" styleClass="drop-icon"/>
                    <Label text="Arrastra tu archivo .xlsx aquí" styleClass="drop-text"/>
                    <Label text="o" styleClass="drop-text-muted"/>
                    <Button fx:id="btnSeleccionarArchivo" text="Seleccionar archivo"
                            styleClass="btn-secondary" onAction="#onSeleccionarArchivo"/>
                    <Label fx:id="lblArchivoSeleccionado" styleClass="drop-file-name" visible="false" managed="false"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

    <Region minHeight="8"/>
    <Label fx:id="lblError" styleClass="error-text" wrapText="true" visible="false" managed="false"/>

    <Region minHeight="16"/>
    <Separator/>
    <Region minHeight="12"/>

    <!-- Acciones -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancelar" text="Cancelar" styleClass="btn-secondary" onAction="#onCancelar"/>
        <Button fx:id="btnValidarImportar" text="Validar e importar" styleClass="btn-primary"
                onAction="#onValidarEImportar" disable="true"/>
    </HBox>
</VBox>


