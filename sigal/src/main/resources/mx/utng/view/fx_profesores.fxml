<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="page-root" stylesheets="@styles_profesores.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.ProfesoresController">

    <VBox spacing="16.0">
        <padding>
            <Insets bottom="18.0" left="34.0" right="34.0" top="14.0" />
        </padding>

        <!-- ============ CONTENIDO: FORMULARIO + TABLA ============ -->
        <HBox spacing="18.0" VBox.vgrow="ALWAYS">

            <!-- ==== PANEL IZQUIERDO: DATOS DEL PROFESOR ==== -->
            <VBox prefWidth="400.0" spacing="14.0" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-title" text="Datos del profesor" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNuevoProfesor" onAction="#onNuevoProfesor" styleClass="btn-nuevo" text="+  Nuevo" />
                </HBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Nombre *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="👤" />
                        <TextField fx:id="txtNombre" promptText="Ej. Juan" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Apellido paterno *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="🪪" />
                        <TextField fx:id="txtApellidoPaterno" promptText="Ej. Pérez" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Apellido materno" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="🪪" />
                        <TextField fx:id="txtApellidoMaterno" promptText="Ej. García" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Correo electrónico" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="✉" />
                        <TextField fx:id="txtCorreo" promptText="Ej. juan.perez@utng.edu.mx" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <Label styleClass="field-label" text="Usuario vinculado *" />
                    <ComboBox fx:id="cmbUsuario" maxWidth="Infinity" promptText="Seleccione el usuario" styleClass="input-combo" />
                </VBox>

                <HBox spacing="8.0">
                    <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="primary-btn" text="💾  Guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="secondary-btn" text="↻  Limpiar" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="cancel-btn" text="✕  Cancelar" />
                </HBox>
            </VBox>

            <!-- ==== PANEL DERECHO: PROFESORES REGISTRADOS ==== -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                <Label styleClass="card-title" text="Profesores registrados" />

                <HBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="input-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="input-icon" text="🔍" />
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, apellido o correo..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="cmbFiltroUsuario" prefWidth="180.0" styleClass="input-combo" />
                    <ComboBox fx:id="cmbFiltroRol" prefWidth="160.0" styleClass="input-combo" />
                    <Button fx:id="btnRefrescar" onAction="#onRefrescar" styleClass="icon-btn" text="↻" />
                </HBox>

                <TableView fx:id="tblProfesores" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNo" prefWidth="50.0" sortable="false" text="No." />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre completo" />
                        <TableColumn fx:id="colCorreo" prefWidth="210.0" text="Correo electrónico" />
                        <TableColumn fx:id="colUsuario" prefWidth="150.0" text="Usuario vinculado" />
                        <TableColumn fx:id="colRol" prefWidth="110.0" text="Rol" />
                        <TableColumn fx:id="colAcciones" prefWidth="100.0" sortable="false" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblResultados" styleClass="results-label" text="Mostrando 0 de 0 profesores" />
            </VBox>

        </HBox>
    </VBox>
</StackPane>
