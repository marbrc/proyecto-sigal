<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" styleClass="ajustes-content" stylesheets="@styles_ajustes.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.AjustesController">

    <VBox fx:id="rootAjustes" spacing="20.0" styleClass="ajustes-content">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="24.0" />
        </padding>

        <!-- Tres tarjetas -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- Perfil de usuario -->
            <VBox spacing="14.0" styleClass="card" prefWidth="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-icon" text="👤" />
                    <VBox>
                        <Label styleClass="card-title" text="Perfil de usuario" />
                        <Label styleClass="card-subtitle" text="Información básica de tu cuenta." />
                    </VBox>
                </HBox>

                <StackPane alignment="CENTER" prefHeight="90.0">
                    <Circle radius="40.0" styleClass="avatar-circle" />
                    <Label fx:id="lblAvatarIcono" styleClass="avatar-icon" text="👤" />
                    <ImageView fx:id="imgAvatarAjustes" fitHeight="80.0" fitWidth="80.0" managed="false" preserveRatio="false" visible="false" />
                </StackPane>

                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Usuario" />
                    <Label fx:id="lblUsuario" styleClass="field-value" text="Usuario" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Rol" />
                    <Label fx:id="lblRol" styleClass="field-value" text="Usuario" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Correo electrónico" />
                    <Label fx:id="lblCorreo" styleClass="field-value" text="usuario@utng.edu.mx" />
                </VBox>
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="Último acceso" />
                    <Label fx:id="lblUltimoAcceso" styleClass="field-value" text="25/07/2026 08:30 PM" />
                </VBox>
            </VBox>

            <!-- Notificaciones -->
            <VBox spacing="14.0" styleClass="card" prefWidth="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-icon" text="🔔" />
                    <VBox>
                        <Label styleClass="card-title" text="Notificaciones" />
                        <Label styleClass="card-subtitle" text="Configura qué notificaciones deseas recibir." />
                    </VBox>
                </HBox>

                <HBox spacing="12.0" styleClass="notif-row">
                    <Label styleClass="notif-icon-blue" text="🛠" />
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="notif-title" text="Avisos de mantenimiento" wrapText="true" />
                        <Label styleClass="notif-desc" text="Recibe notificaciones sobre mantenimientos programados o emergencias." wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0">
                        <ToggleButton fx:id="toggleMantenimiento" onAction="#onToggleMantenimiento" selected="true" styleClass="switch" />
                        <Label fx:id="lblEstadoMantenimiento" styleClass="notif-status" text="Activado" />
                    </VBox>
                </HBox>

                <HBox spacing="12.0" styleClass="notif-row">
                    <Label styleClass="notif-icon-orange" text="🗓" />
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="notif-title" text="Recordatorios de asignaciones" wrapText="true" />
                        <Label styleClass="notif-desc" text="Recibe recordatorios sobre tus asignaciones próximas y confirmaciones." wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0">
                        <ToggleButton fx:id="toggleRecordatorios" onAction="#onToggleRecordatorios" selected="true" styleClass="switch" />
                        <Label fx:id="lblEstadoRecordatorios" styleClass="notif-status" text="Activado" />
                    </VBox>
                </HBox>

                <HBox spacing="12.0" styleClass="notif-row">
                    <Label styleClass="notif-icon-green" text="✉" />
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="notif-title" text="Reportes semanales" wrapText="true" />
                        <Label styleClass="notif-desc" text="Recibe un resumen semanal de actividades y reportes del sistema." wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0">
                        <ToggleButton fx:id="toggleReportes" onAction="#onToggleReportes" selected="true" styleClass="switch" />
                        <Label fx:id="lblEstadoReportes" styleClass="notif-status" text="Activado" />
                    </VBox>
                </HBox>

                <HBox styleClass="info-box">
                    <Label styleClass="info-text" text="ℹ  Puedes recibir las notificaciones en el sistema. (A futuro se habilitarán más canales de notificación)." wrapText="true" />
                </HBox>
            </VBox>

            <!-- Tema -->
            <VBox spacing="14.0" styleClass="card" prefWidth="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-icon" text="🎨" />
                    <VBox>
                        <Label styleClass="card-title" text="Apariencia" />
                        <Label styleClass="card-subtitle" text="Personaliza la apariencia visual del sistema." />
                    </VBox>
                </HBox>

                <Label styleClass="field-label" text="Tema del sistema" />
                <Label styleClass="card-subtitle" text="Selecciona el tema que prefieres utilizar." wrapText="true" />

                <VBox spacing="10.0">
                    <VBox fx:id="cardTemaAzul" alignment="CENTER_LEFT" onMouseClicked="#seleccionarTemaAzul" spacing="2.0" styleClass="theme-card-selected">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="theme-icon" text="🔷" />
                            <Label styleClass="theme-label" text="Azul original (SIGAL)" />
                        </HBox>
                    </VBox>
                    <VBox fx:id="cardTemaOscuro" alignment="CENTER_LEFT" onMouseClicked="#seleccionarTemaOscuro" spacing="2.0" styleClass="theme-card">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="theme-icon" text="🌙" />
                            <Label styleClass="theme-label" text="Tema oscuro" />
                        </HBox>
                    </VBox>
                    <VBox fx:id="cardTemaClaro" alignment="CENTER_LEFT" onMouseClicked="#seleccionarTemaClaro" spacing="2.0" styleClass="theme-card">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="theme-icon" text="☀" />
                            <Label styleClass="theme-label" text="Tema claro" />
                        </HBox>
                    </VBox>
                </VBox>

                <HBox styleClass="info-box">
                    <Label styleClass="info-text" text="ℹ  El logotipo institucional de SIGAL es fijo y no puede ser modificado desde este módulo." wrapText="true" />
                </HBox>
            </VBox>

        </HBox>

        <!-- Barra de guardar -->
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="save-bar">
            <Label styleClass="save-icon" text="🛡" />
            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="save-title" text="Guardar cambios" />
                <Label styleClass="save-subtitle" text="Aplica tus cambios y preferencias." />
            </VBox>
            <Button fx:id="btnGuardarCambios" onAction="#guardarCambios" styleClass="btn-guardar" text="💾  Guardar cambios" />
        </HBox>

        <Label styleClass="footer-text" text="SIGAL © 2026 - Sistema de Gestión y Asignación de Laboratorios">
            <VBox.margin>
                <Insets bottom="6.0" top="6.0" />
            </VBox.margin>
        </Label>

    </VBox>

</ScrollPane>
