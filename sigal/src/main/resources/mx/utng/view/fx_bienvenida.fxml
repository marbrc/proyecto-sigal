<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
    

<StackPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.BienvenidaController">

    <!-- FONDO -->
    <!-- Coloca tu imagen de fondo (la 3ra que enviaste) en la misma carpeta
         que este FXML, dentro de assets/, con el nombre background.jpg -->
    <ImageView fx:id="imgBackground" preserveRatio="false" smooth="true">
        <image>
            <Image backgroundLoading="true" url="@assets/background.jpg" />
        </image>
    </ImageView>

    <!-- Overlay oscuro para dar legibilidad sobre la foto -->
    <Rectangle fx:id="overlay" styleClass="bg-overlay" />

    <!-- CONTENIDO -->
    <BorderPane fx:id="rootLayout">

        <!-- BARRA SUPERIOR: solo hora y clima -->
        <top>
            <HBox alignment="CENTER_RIGHT" spacing="14.0" styleClass="navbar" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="14.0" left="40.0" right="40.0" top="14.0" />
                </padding>

                <HBox alignment="CENTER" spacing="12.0" styleClass="chip">
                    <Label styleClass="chip-icon" text="🕒" />
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="lblHora" styleClass="chip-title" text="10:45 AM" />
                        <Label fx:id="lblFecha" styleClass="chip-sub" text="Sábado, 25 de Julio 2026" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="12.0" styleClass="chip">
                    <Label styleClass="chip-icon" text="⛅" />
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTemp" styleClass="chip-title" text="24°C" />
                        <Label fx:id="lblClima" styleClass="chip-sub" text="Parcialmente nublado" />
                    </VBox>
                </HBox>
            </HBox>
        </top>

        <!-- CENTRO: HERO + SIDEBAR -->
        <center>
            <HBox BorderPane.alignment="CENTER">

                <!-- HERO -->
                <StackPane HBox.hgrow="ALWAYS">
                    <VBox alignment="CENTER" maxWidth="780.0" spacing="18.0">

                        <!-- Logo grande, sin recortes -->
                        <ImageView fx:id="imgLogo" fitHeight="290.0" fitWidth="290.0" preserveRatio="true" smooth="true" styleClass="logo-image">
                            <image>
                                <Image backgroundLoading="true" url="@assets/logo.png" />
                            </image>
                            <effect>
                                <DropShadow color="#4fc3ff" radius="35" spread="0.15" />
                            </effect>
                        </ImageView>

                        <VBox alignment="CENTER" spacing="4.0">
                            <Label styleClass="hero-title" text="¡BIENVENIDO!" />
                            <HBox alignment="CENTER">
                                <Label styleClass="hero-subtitle" text="AL SISTEMA " />
                                <Label styleClass="hero-subtitle-accent" text="SIGAL" />
                            </HBox>
                        </VBox>

                        <Region maxWidth="140.0" minHeight="3.0" prefHeight="3.0" styleClass="hero-divider" />

                        <Label maxWidth="560.0" styleClass="hero-desc" text="Administra, reserva y consulta la disponibilidad de laboratorios de forma eficiente." textAlignment="CENTER" wrapText="true" />
                        <Label fx:id="lblSaludo" styleClass="hero-saludo" text="¡Bienvenido!" wrapText="true"/> 
                        <HBox alignment="CENTER" spacing="20.0">
                            <Button fx:id="btnIniciarSesion" onAction="#iniciarSesion" contentDisplay="GRAPHIC_ONLY" prefHeight="66.0" prefWidth="300.0" styleClass="btn-primary">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="256.0" spacing="14.0">
                                        <StackPane styleClass="btn-icon-box">
                                            <Label styleClass="btn-icon" text="[→]" />
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <Label styleClass="btn-title" text="Iniciar sesión" />
                                            <Label styleClass="btn-sub" text="Accede a tu cuenta" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="btn-chevron" text="›" />
                                    </HBox>
                                </graphic>
                            </Button>

                            <Button fx:id="btnRegistrarse" onAction="#registrarse" contentDisplay="GRAPHIC_ONLY" prefHeight="66.0" prefWidth="300.0" styleClass="btn-secondary">
                                <graphic>
                                    <HBox alignment="CENTER_LEFT" prefWidth="256.0" spacing="14.0">
                                        <StackPane styleClass="btn-icon-box-outline">
                                            <Label styleClass="btn-icon-outline" text="👤" />
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT">
                                            <Label styleClass="btn-title" text="Registrarse" />
                                            <Label styleClass="btn-sub" text="Crea una nueva cuenta" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="btn-chevron" text="›" />
                                    </HBox>
                                </graphic>
                            </Button>
                        </HBox>

                    </VBox>
                </StackPane>

                <!-- SIDEBAR -->
                <VBox prefWidth="380.0" spacing="18.0" styleClass="sidebar">
                    <padding>
                        <Insets bottom="20.0" left="0.0" right="30.0" top="0.0" />
                    </padding>

                    <!-- Calendario -->
                    <VBox spacing="14.0" styleClass="card">
                        <HBox alignment="CENTER" spacing="10.0">
                            <Button styleClass="cal-nav-btn" text="‹" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="card-title" text="Julio 2026" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button styleClass="cal-nav-btn" text="›" />
                        </HBox>

                        <GridPane hgap="6.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                                <ColumnConstraints halignment="CENTER" percentWidth="14.2857" />
                            </columnConstraints>

                            <!-- Encabezado días de la semana -->
                            <Label styleClass="cal-weekday" text="Lun" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Mar" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Mié" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Jue" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Vie" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Sáb" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                            <Label styleClass="cal-weekday" text="Dom" GridPane.columnIndex="6" GridPane.rowIndex="0" />

                            <!-- Semana 1 -->
                            <Label styleClass="cal-day" text="1" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Label styleClass="cal-day" text="2" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            <Label styleClass="cal-day" text="3" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                            <Label styleClass="cal-day" text="4" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                            <Label styleClass="cal-day" text="5" GridPane.columnIndex="6" GridPane.rowIndex="1" />

                            <!-- Semana 2 -->
                            <Label styleClass="cal-day" text="6" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="7" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="8" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="9" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="10" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="11" GridPane.columnIndex="5" GridPane.rowIndex="2" />
                            <Label styleClass="cal-day" text="12" GridPane.columnIndex="6" GridPane.rowIndex="2" />

                            <!-- Semana 3 -->
                            <Label styleClass="cal-day" text="13" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="14" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="15" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="16" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="17" GridPane.columnIndex="4" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="18" GridPane.columnIndex="5" GridPane.rowIndex="3" />
                            <Label styleClass="cal-day" text="19" GridPane.columnIndex="6" GridPane.rowIndex="3" />

                            <!-- Semana 4 -->
                            <Label styleClass="cal-day" text="20" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day" text="21" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day" text="22" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day" text="23" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day" text="24" GridPane.columnIndex="4" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day-today" text="25" GridPane.columnIndex="5" GridPane.rowIndex="4" />
                            <Label styleClass="cal-day" text="26" GridPane.columnIndex="6" GridPane.rowIndex="4" />

                            <!-- Semana 5 -->
                            <Label styleClass="cal-day" text="27" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <Label styleClass="cal-day" text="28" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            <Label styleClass="cal-day" text="29" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                            <Label styleClass="cal-day" text="30" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                            <Label styleClass="cal-day" text="31" GridPane.columnIndex="4" GridPane.rowIndex="5" />
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Próximas reservaciones -->
                    <VBox spacing="10.0" styleClass="card">
                        <Label styleClass="card-title" text="🗓  Próximas reservaciones" />
                        <VBox spacing="2.0" styleClass="reservation-row">
                            <Label styleClass="reservation-name" text="Lab. de Programación" />
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label styleClass="reservation-time" text="11:00 AM - 01:00 PM" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="badge-confirmed" text="Confirmada" />
                            </HBox>
                        </VBox>
                        <VBox spacing="2.0" styleClass="reservation-row">
                            <Label styleClass="reservation-name" text="Lab. de Redes" />
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label styleClass="reservation-time" text="03:00 PM - 05:00 PM" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="badge-pending" text="Pendiente" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Labs disponibles -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
                        <Label styleClass="chip-icon" text="💻" />
                        <VBox>
                            <Label styleClass="card-title" text="12 Laboratorios disponibles" />
                            <Label styleClass="placeholder-text" text="" />
                        </VBox>
                    </HBox>
                </VBox>

            </HBox>
        </center>

        <!-- FOOTER -->
        <bottom>
            <VBox alignment="CENTER" spacing="16.0" styleClass="footer-box" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="22.0" left="0.0" right="0.0" top="10.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" maxWidth="480.0" styleClass="quote-card">
                    <VBox spacing="6.0">
                        <Label styleClass="quote-text" text="La tecnología es mejor cuando une a las personas." wrapText="true" />
                        <Label styleClass="quote-author" text="— Matt Mullenweg" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="8.0" />
            </VBox>
        </bottom>

    </BorderPane>
</StackPane>
