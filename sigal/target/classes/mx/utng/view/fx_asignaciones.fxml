<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane styleClass="menu-root" stylesheets="@styles_asignaciones.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.AsignacionesController">

    <BorderPane fx:id="mainLayout">
        <center>
            <ScrollPane fitToWidth="true" styleClass="menu-content-bg" BorderPane.alignment="CENTER">
            <VBox styleClass="menu-content-bg">

                <!-- NUEVA ASIGNACIÓN -->
                <VBox maxWidth="Infinity" spacing="10.0" styleClass="panel-card-compact, panel-glow-blue">                            <padding>
                        <Insets bottom="4.0" left="34.0" right="34.0" top="8.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <StackPane styleClass="panel-icon-box-blue">
                            <Group>
                                <Rectangle arcHeight="2" arcWidth="2" height="12" styleClass="icon-stroke-blue" width="14" x="-7" y="-5" />
                                <Line endX="-3.5" endY="-4" startX="-3.5" startY="-7" styleClass="icon-stroke-blue" />
                                <Line endX="3.5" endY="-4" startX="3.5" startY="-7" styleClass="icon-stroke-blue" />
                                <Line endX="7" endY="-1" startX="-7" startY="-1" styleClass="icon-stroke-blue" />
                            </Group>
                        </StackPane>
                        <Label styleClass="panel-title" text="Nueva asignación" />
                    </HBox>

                    <GridPane hgap="12.0" vgap="5.0">
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>

    <!-- Fila 1: Solicitante y Espacio -->
    <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <Label styleClass="field-label" text="Solicitante *" />
        <ComboBox fx:id="cmbSolicitante" maxWidth="Infinity" promptText="Seleccionar tipo" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.columnSpan="2">
        <Label styleClass="field-label" text="Nombre del solicitante *" />
        <ComboBox fx:id="cmbNombreSolicitante" editable="true" maxWidth="Infinity" promptText="Escriba o elija un nombre" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
        <Label styleClass="field-label" text="Tipo de espacio *" />
        <ComboBox fx:id="cmbTipoEspacio" maxWidth="Infinity" promptText="Laboratorio / Aula / Sala" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="4" GridPane.rowIndex="0">
        <Label styleClass="field-label" text="Espacio *" />
        <ComboBox fx:id="cmbEspacio" disable="true" maxWidth="Infinity" promptText="Elige un tipo primero" styleClass="field-combo" />
    </VBox>

    <!-- Fila 2: Carrera, Cuatrimestre, Materia, Grupo, Alumnos -->
    <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
        <Label styleClass="field-label" text="Carrera " />
        <ComboBox fx:id="cmbCarrera" maxWidth="Infinity" promptText="Seleccionar carrera" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
        <Label styleClass="field-label" text="Cuatrimestre *" />
        <ComboBox fx:id="cmbCuatrimestre" maxWidth="Infinity" promptText="Cuatri" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
    <Label styleClass="field-label" text="Materia " />
    <ComboBox fx:id="cmbMateria" maxWidth="Infinity" promptText="Elige carrera y cuatrimestre" styleClass="field-combo" />
</VBox>

    <VBox spacing="3.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
        <Label styleClass="field-label" text="Grupo " />
        <ComboBox fx:id="cmbGrupo" maxWidth="Infinity" promptText="Seleccionar grupo" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="4" GridPane.rowIndex="1">
        <Label styleClass="field-label" text="Número de alumnos *" />
        <TextField fx:id="txtNumAlumnos" promptText="Cantidad" styleClass="field-input" />
    </VBox>

    <!-- Fila 3: Fecha y Horarios -->
    <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
        <Label styleClass="field-label" text="Fecha *" />
        <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="Seleccionar fecha" styleClass="field-date" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="1">
        <Label styleClass="field-label" text="Hora inicio *" />
        <ComboBox fx:id="cmbHoraInicio" maxWidth="Infinity" promptText="Seleccionar hora" styleClass="field-combo" />
    </VBox>
    <VBox spacing="3.0" GridPane.columnIndex="3" GridPane.rowIndex="2" GridPane.columnSpan="2">
        <Label styleClass="field-label" text="Hora término *" />
        <ComboBox fx:id="cmbHoraTermino" maxWidth="Infinity" promptText="Seleccionar hora" styleClass="field-combo" />
    </VBox>

    <!-- Fila 4: Actividad -->
    <VBox spacing="3.0" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="5">
        <Label styleClass="field-label" text="Actividad o motivo *" />
        <TextArea fx:id="txtActividad" prefHeight="26.0" promptText="Describa la actividad o motivo de la asignación" styleClass="field-textarea" wrapText="true" />
    </VBox>
</GridPane>

                    <HBox alignment="CENTER_RIGHT" prefHeight="30.0" prefWidth="1270.0" spacing="10.0">
                        <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="btn-secondary-compact" text="↻  Limpiar" />
                        <Button fx:id="btnGuardar" onAction="#onGuardarAsignacion" styleClass="btn-primary-compact" text="✓  Guardar asignación" />
                    </HBox>
                </VBox>

                <!-- ASIGNACIONES REGISTRADAS -->
                <VBox spacing="10.0" styleClass="panel-card-table" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="18.0" left="34.0" right="34.0" top="6.0" />
                    </padding>

                    <VBox spacing="14.0" styleClass="panel-card, panel-glow-blue">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane styleClass="panel-icon-box-blue">
                                    <Group>
                                        <Rectangle arcHeight="2" arcWidth="2" height="12" styleClass="icon-stroke-blue" width="14" x="-7" y="-5" />
                                        <Line endX="-3.5" endY="-4" startX="-3.5" startY="-7" styleClass="icon-stroke-blue" />
                                        <Line endX="3.5" endY="-4" startX="3.5" startY="-7" styleClass="icon-stroke-blue" />
                                        <Line endX="7" endY="-1" startX="-7" startY="-1" styleClass="icon-stroke-blue" />
                                    </Group>
                                </StackPane>
                                <Label styleClass="panel-title" text="Asignaciones registradas" />
                            </HBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtBuscar" promptText="Buscar por ID o solicitante/profesor..." styleClass="search-input" />
                        </HBox>

                        <TableView fx:id="tablaAsignaciones" styleClass="asig-table" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label styleClass="asig-table-placeholder" text="No hay asignaciones registradas todavía" />
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                                <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
                                <TableColumn fx:id="colHora" prefWidth="120.0" text="Hora" />
                                <TableColumn fx:id="colEspacio" prefWidth="130.0" text="Espacio" />
                                <TableColumn fx:id="colSolicitante" prefWidth="120.0" text="Solicitante" />
                                <TableColumn fx:id="colNombreSolicitante" prefWidth="150.0" text="Nombre" />
                                <TableColumn fx:id="colMateria" prefWidth="140.0" text="Materia" />
                                <TableColumn fx:id="colGrupo" prefWidth="70.0" text="Grupo" />
                                <TableColumn fx:id="colActividad" prefWidth="90.0" text="Actividad" />
                                <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
                                <TableColumn fx:id="colAcciones" prefWidth="110.0" sortable="false" text="Acciones" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER">
                            <Pagination fx:id="paginacion" maxPageIndicatorCount="5" pageCount="12" styleClass="asig-pagination" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

</StackPane>
