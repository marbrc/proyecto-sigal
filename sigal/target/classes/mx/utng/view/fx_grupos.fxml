<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="page-root" stylesheets="@styles_catalogo_crud.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.GruposController">

    <VBox spacing="14.0">
        <padding>
            <Insets bottom="18.0" left="34.0" right="34.0" top="14.0" />
        </padding>

        <!-- ============ ENCABEZADO: VOLVER AL CATALOGO ============ -->
        <HBox alignment="CENTER_LEFT">
            <Button onAction="#onVolverCatalogo" styleClass="btn-volver-inline" text="←  Volver al Catálogo Académico" />
        </HBox>

        <!-- ============ CONTENIDO: FORMULARIO + TABLA ============ -->
        <HBox spacing="18.0" VBox.vgrow="ALWAYS">

            <!-- ==== PANEL IZQUIERDO: DATOS DEL GRUPO ==== -->
            <VBox prefWidth="400.0" spacing="12.0" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-title" text="Datos del grupo" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNuevoGrupo" onAction="#onNuevoGrupo" styleClass="btn-nuevo" text="+  Nuevo" />
                </HBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Nombre del grupo *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="👥" />
                        <TextField fx:id="txtNombre" promptText="Ej. GTID235" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <HBox spacing="12.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Capacidad *" />
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                            <Label styleClass="input-icon" text="🔢" />
                            <TextField fx:id="txtCapacidad" promptText="Ej. 30" styleClass="input-field" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Cuatrimestre *" />
                        <ComboBox fx:id="cmbCuatrimestre" maxWidth="Infinity" promptText="Seleccione" styleClass="input-combo" />
                    </VBox>
                </HBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Turno *" />
                    <ComboBox fx:id="cmbTurno" maxWidth="Infinity" promptText="Seleccione el turno" styleClass="input-combo" />
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <Label styleClass="field-label" text="Carrera *" />
                    <ComboBox fx:id="cmbCarrera" maxWidth="Infinity" promptText="Seleccione la carrera" styleClass="input-combo" />
                </VBox>

                <HBox spacing="8.0">
                    <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="primary-btn" text="💾  Guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="secondary-btn" text="↻  Limpiar" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="cancel-btn" text="✕  Cancelar" />
                </HBox>
            </VBox>

            <!-- ==== PANEL DERECHO: GRUPOS REGISTRADOS ==== -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
                <Label styleClass="card-title" text="Grupos registrados" />

                <HBox spacing="8.0">
                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="input-box" HBox.hgrow="ALWAYS">
                        <Label styleClass="input-icon" text="🔍" />
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre del grupo..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="cmbFiltroCarrera" prefWidth="190.0" styleClass="input-combo" />
                    <ComboBox fx:id="cmbFiltroTurno" prefWidth="150.0" styleClass="input-combo" />
                    <Button fx:id="btnRefrescar" onAction="#onRefrescar" styleClass="icon-btn" text="↻" />
                </HBox>

                <TableView fx:id="tblGrupos" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNo" prefWidth="45.0" sortable="false" text="No." />
                        <TableColumn fx:id="colNombre" prefWidth="130.0" text="Grupo" />
                        <TableColumn fx:id="colCapacidad" prefWidth="90.0" text="Capacidad" />
                        <TableColumn fx:id="colCuatrimestre" prefWidth="100.0" text="Cuatrim." />
                        <TableColumn fx:id="colTurno" prefWidth="110.0" text="Turno" />
                        <TableColumn fx:id="colCarrera" prefWidth="210.0" text="Carrera" />
                        <TableColumn fx:id="colAcciones" prefWidth="95.0" sortable="false" text="Acciones" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Label fx:id="lblResultados" styleClass="results-label" text="Mostrando 0 de 0 grupos" />
            </VBox>

        </HBox>
    </VBox>
</StackPane>
