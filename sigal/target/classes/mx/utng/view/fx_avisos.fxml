<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="page-root" stylesheets="@styles_avisos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.AvisosController">

    <VBox spacing="16.0">
        <padding>
            <Insets bottom="18.0" left="34.0" right="34.0" top="14.0" />
        </padding>

        <!-- ============ ENCABEZADO ============ -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <VBox spacing="4.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNuevoAviso" onAction="#onNuevoAviso" styleClass="primary-btn" text="+  Nuevo aviso" />
        </HBox>

        <!-- ============ FILTROS DE BUSQUEDA ============ -->
        <VBox spacing="12.0" styleClass="card">
            <Label styleClass="card-title" text="Filtros de búsqueda" />

            <HBox spacing="14.0">
                <VBox prefWidth="180.0" spacing="6.0">
                    <Label styleClass="field-label" text="Espacio" />
                    <ComboBox fx:id="cmbFiltroEspacio" prefWidth="180.0" promptText="Todos" styleClass="input-combo" />
                </VBox>
                <VBox prefWidth="180.0" spacing="6.0">
                    <Label styleClass="field-label" text="Tipo de aviso" />
                    <ComboBox fx:id="cmbFiltroTipo" prefWidth="180.0" promptText="Todos" styleClass="input-combo" />
                </VBox>
                <VBox prefWidth="180.0" spacing="6.0">
                    <Label styleClass="field-label" text="Estado" />
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="180.0" promptText="Todos" styleClass="input-combo" />
                </VBox>
                <VBox prefWidth="160.0" spacing="6.0">
                    <Label styleClass="field-label" text="Desde" />
                    <DatePicker fx:id="dpDesde" prefWidth="160.0" styleClass="input-combo" />
                </VBox>
                <VBox prefWidth="160.0" spacing="6.0">
                    <Label styleClass="field-label" text="Hasta" />
                    <DatePicker fx:id="dpHasta" prefWidth="160.0" styleClass="input-combo" />
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnLimpiarFiltros" onAction="#onLimpiarFiltros" styleClass="secondary-btn" text="Limpiar filtros" />
                <Button fx:id="btnBuscar" onAction="#onBuscar" styleClass="primary-btn" text="Buscar" />
            </HBox>
        </VBox>

        <!-- ============ CONTENIDO: TABLA + RESUMEN ============ -->
        <HBox spacing="18.0" VBox.vgrow="ALWAYS">

            <!-- ==== HISTORIAL DE AVISOS ==== -->
            <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label styleClass="card-title" text="Historial de avisos" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="dim" text="Hay" />
                    <Label fx:id="lblContador" styleClass="purple" text="0" />
                    <Label styleClass="dim" text="avisos" />
                    <Button fx:id="btnMarcarLeidos" onAction="#onMarcarLeidos" styleClass="secondary-btn" text="Marcar como leídos" />
                </HBox>

                <TableView fx:id="tblAvisos" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFecha" prefWidth="85.0" text="Fecha" />
                        <TableColumn fx:id="colEspacio" prefWidth="110.0" text="Espacio" />
                        <TableColumn fx:id="colHoraInicio" prefWidth="105.0" text="Hora Inicio" />
                        <TableColumn fx:id="colHoraTermino" prefWidth="170.0" text="Hora Termino" />                        
                        <TableColumn fx:id="colTipo" prefWidth="105.0" text="Tipo de aviso" />
                        <TableColumn fx:id="colDescripcion" prefWidth="170.0" text="Descripción" />
                        <TableColumn fx:id="colComentarios" prefWidth="150.0" text="Comentarios" />
                        <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="80.0" text="Acciones" />
                    </columns>
                    <placeholder>
                        <Label styleClass="dim" text="No hay avisos registrados todavía." />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ==== RESUMEN DE AVISOS ==== -->
            <VBox prefWidth="230.0" spacing="10.0" styleClass="card">
                <Label styleClass="card-title" text="Resumen de avisos" />

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="tipo-dot,tipo-dot-info" text="●" />
                    <Label styleClass="resumen-label" text="Información" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblInformacion" styleClass="resumen-valor" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="tipo-dot,tipo-dot-warn" text="●" />
                    <Label styleClass="resumen-label" text="Advertencia" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblAdvertencia" styleClass="resumen-valor" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="tipo-dot,tipo-dot-error" text="●" />
                    <Label styleClass="resumen-label" text="Error" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblError" styleClass="resumen-valor" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="tipo-dot,tipo-dot-exito" text="●" />
                    <Label styleClass="resumen-label" text="Éxito" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblExito" styleClass="resumen-valor" text="0" />
                </HBox>

                <VBox spacing="4.0" styleClass="info-box">
                    <Label styleClass="info-box-title" text="ℹ  Información" />
                    <Label styleClass="info-box-text" text="Los avisos te mantienen informado sobre eventos, incidencias y novedades de los espacios académicos." wrapText="true" />
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>
