<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="page-root" stylesheets="@styles_catalogo_crud.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.AreaAcademicaController">

    <VBox spacing="14.0">
        <padding>
            <Insets bottom="18.0" left="34.0" right="34.0" top="14.0" />
        </padding>

        <!-- ============ ENCABEZADO: VOLVER AL CATALOGO ============ -->
        <HBox alignment="CENTER_LEFT">
            <Button onAction="#onVolverCatalogo" styleClass="btn-volver-inline" text="←  Volver al Catálogo Académico" />
        </HBox>

        <!-- ============ CONTENIDO: FORMULARIO + TABLA ============ -->
        <HBox spacing="18.0" VBox.vgrow="ALWAYS">

            <!-- ==== PANEL IZQUIERDO: DATOS DEL AREA ACADEMICA ==== -->
            <VBox prefWidth="380.0" spacing="14.0" styleClass="card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="card-title" text="Datos del área académica" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNuevaArea" onAction="#onNuevaArea" styleClass="btn-nuevo" text="+  Nueva" />
                </HBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Nombre del área *" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="input-box">
                        <Label styleClass="input-icon" text="🏫" />
                        <TextField fx:id="txtNombre" promptText="Ej. Tecnologías de la Información" styleClass="input-field" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="8.0">
                    <Button fx:id="btnGuardar" onAction="#onGuardar" styleClass="primary-btn" text="💾  Guardar" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="secondary-btn" text="↻  Limpiar" />
                    <Button fx:id="btnCancelar" onAction="#onCancelar" styleClass="cancel-btn" text="✕  Cancelar" />
                </HBox>
            </VBox>


        </HBox>
    </VBox>
</StackPane>
