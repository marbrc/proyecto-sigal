<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox styleClass="page-root" stylesheets="@styles_horarios.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.utng.controller.HorarioController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <!-- ==== BARRA DE FILTROS ==== -->
    <HBox spacing="18.0" styleClass="card">
        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Tipo de espacio" />
            <ComboBox fx:id="cmbTipoEspacio" prefWidth="190.0" styleClass="input-combo" />
        </VBox>
        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Espacio" />
            <ComboBox fx:id="cmbEspacio" prefWidth="190.0" styleClass="input-combo" />
        </VBox>
        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Fecha" />
            <DatePicker fx:id="dpFecha" prefWidth="170.0" styleClass="input-date" />
        </VBox>
        <VBox spacing="8.0">
            <Label styleClass="field-label" text="Vista" />
            <HBox spacing="0.0" styleClass="view-toggle-group">
                <fx:define>
                    <ToggleGroup fx:id="grupoVista" />
                </fx:define>
                <ToggleButton fx:id="tglDiaria" styleClass="view-toggle-btn" text="Diaria" toggleGroup="$grupoVista" />
                <ToggleButton fx:id="tglSemanal" selected="true" styleClass="view-toggle-btn" text="Semanal" toggleGroup="$grupoVista" />
                <ToggleButton fx:id="tglMensual" styleClass="view-toggle-btn" text="Mensual" toggleGroup="$grupoVista" />
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="BOTTOM_LEFT" spacing="8.0">
            <HBox spacing="10.0">
                <Button fx:id="btnBuscar" onAction="#onBuscar" styleClass="btn-primary" text="🔍  Buscar" />
                <Button fx:id="btnLimpiar" onAction="#onLimpiar" styleClass="btn-secondary" text="↻  Limpiar" />
            </HBox>
        </VBox>
    </HBox>

    <Region minHeight="16.0" prefHeight="16.0" />

    <!-- ==== LEYENDA + NUEVA ASIGNACIÓN ==== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label styleClass="legend-title" text="Estado:" />
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Rectangle arcHeight="4.0" arcWidth="4.0" fill="#22c55e" height="14.0" width="14.0" />
            <Label styleClass="legend-text" text="Libre" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Rectangle arcHeight="4.0" arcWidth="4.0" fill="#4fc3ff" height="14.0" width="14.0" />
            <Label styleClass="legend-text" text="Asignado" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Rectangle arcHeight="4.0" arcWidth="4.0" fill="#f59e0b" height="14.0" width="14.0" />
            <Label styleClass="legend-text" text="Ocupado" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnImportarHorario" onAction="#onImportarHorario" styleClass="btn-secondary" text="⬆  Importar horario" />
            <Button fx:id="btnNuevaAsignacion" onAction="#onNuevaAsignacion" styleClass="btn-primary" text="[+]  Nueva Asignación" />
        </HBox>

    <Region minHeight="16.0" prefHeight="16.0" />

    <!-- ==== CUADRÍCULA DE HORARIOS ==== -->
    <ScrollPane fx:id="scrollHorario" fitToWidth="true" styleClass="grid-scroll" VBox.vgrow="ALWAYS">
        <VBox fx:id="contenedorGrid" styleClass="card" />
    </ScrollPane>

    <Region minHeight="12.0" prefHeight="12.0" />

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label styleClass="footer-icon" text="ⓘ" />
        <Label styleClass="footer-text" text="La información mostrada se actualiza en tiempo real." />
    </HBox>
</VBox>
